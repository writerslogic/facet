{
  // Facet Worker config: ingest + stats API + dashboard static assets + cron rollups.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facet",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Optional: serve on your own domain. Uncomment and set your hostname; the zone must already be on
  // the deploying Cloudflare account, and deploy provisions the DNS record and cert. Left commented
  // so a fresh clone deploys to its workers.dev URL instead of failing on a zone it does not own.
  // "routes": [{ "pattern": "analytics.example.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // Hourly cron: aggregate raw events into rollups and enforce retention.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // Dashboard build output, served by the Worker for non-API routes.
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facet",
      "database_id": "PLACEHOLDER_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Rolling retention window for raw events, in days.
    "RAW_RETENTION_DAYS": "90"
  },
  // Workers AI: translates natural-language analytics questions into a constrained query intent.
  "ai": {
    "binding": "AI"
  },
  // Rate limiter for the public /api/collect beacon (per client IP) and /api/event (per site). The
  // middleware fails open if this binding is absent, so it MUST be present in production. Tune limit/
  // period to your traffic; namespace_id is an arbitrary unique integer for this account.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 100, "period": 60 }
      }
    ]
  },

  // Ingest queue: the beacon enqueues a derived (IP-free) event and returns immediately; a consumer
  // batches the D1 writes off the hot path. At-least-once with idempotent inserts (id minted at derive
  // time + onConflictDoNothing), so a retried batch can never duplicate an event.
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "facet-ingest" }],
    "consumers": [
      { "queue": "facet-ingest", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },

  // Analytics Engine: the columnar analytical store (U1). Every accepted event is mirrored here at
  // derive time alongside its D1 row — D1 stays the authoritative metadata/config store and serves
  // the bounded queries its indexes cover, AE absorbs the high-cardinality, arbitrary-dimension
  // scans SQLite cannot. The binding is OPTIONAL in `Env`: with it unbound, every AE write no-ops
  // and D1 remains the only store, so removing this block is a supported deployment.
  // Reads (SQL over HTTP) additionally need the `CF_ACCOUNT_ID` var and the `CF_API_TOKEN` secret.
  //
  // RETENTION: AE stores a data point for three months and has NO delete API. Setting
  // RAW_RETENTION_DAYS below 90 therefore turns the mirror OFF (lib/ae.ts) rather than let a copy
  // outlive the window this deployment advertises — a shorter window means D1-only, by design.
  //
  // QUOTA: writes are metered (Workers Free: 100k data points/day; Paid: 10M/month included). One
  // accepted event is one data point, so size the plan to traffic before enabling this on a busy site.
  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "facet_events" }]

  // ─────────────────────────────────────────────────────────────────────────
  // OPTIONAL — email alert delivery via Cloudflare Email Routing.
  // Alerting works out of the box over signed webhooks; email is strictly additive. It stays
  // commented out because enabling it is a ZONE-level prerequisite, not just a config line: Email
  // Routing must be enabled on the zone and each recipient verified, and deploying this binding
  // without that fails the deploy. Uncomment BOTH the binding and the ALERT_EMAIL_FROM var (a
  // verified sender on that zone) to turn the email transport on; with either missing, an email
  // destination records `email_unconfigured` and nothing else changes.
  //   "send_email": [{ "name": "SEND_EMAIL" }],
  //   "vars": { "ALERT_EMAIL_FROM": "alerts@your-zone.example" },
  //
  // ─────────────────────────────────────────────────────────────────────────
  // POST-v1 SCALE PATH — Cloudflare-native bindings, intentionally disabled.
  // Uncomment a block only when adopting that capability; each is out of v1 scope.
  // ─────────────────────────────────────────────────────────────────────────
  //
  // Durable Objects + alarms — exactly-once real-time aggregation (1 DO per
  // metric_key+time_bucket, alarm flushes to D1/AE every 5s) for live dashboards.
  //   "durable_objects": {
  //     "bindings": [{ "name": "AGGREGATOR", "class_name": "Aggregator" }]
  //   },
  //   "migrations": [{ "tag": "v2", "new_sqlite_classes": ["Aggregator"] }],
  //
  // R2 — CSV/Parquet exports and nightly AE→R2 archival (presigned URLs via S3 API).
  //   "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "facet-exports" }],
}
